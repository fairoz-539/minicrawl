# minicrawl settings. Easiest: run scripts/setup.sh (or scripts\setup.ps1), which
# creates .env with your own generated keys. Or copy this file to `.env` and edit it.
# Never commit .env or share it: it holds YOUR keys (git and Docker already ignore it).
# Used by `docker compose` and by `npm start` (local, without Docker).
# Lines starting with # are ignored. Leave a value empty to use the default.

# --- Access -------------------------------------------------------------------
# Required in Docker. Clients send it as:  Authorization: Bearer <key>
# Generate one:  openssl rand -hex 32
#   (PowerShell:  -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_}))
API_KEY=
# Several keys (one per person/app), comma-separated. Works alongside API_KEY.
# API_KEYS=key-for-alice,key-for-bob
# Run without any key (only on a trusted machine/network).
# ALLOW_NO_AUTH=true
# Teams, per-team keys, quotas and the audit log: see docs/ADMIN.md.
# The keys above act as owners of the "default" team.

# --- Teams and audit (docs/ADMIN.md) -----------------------------------------------
# Behind a reverse proxy: trust X-Forwarded-For so IP allowlists see the client (1 = one proxy).
# TRUST_PROXY=1
# Record every API call in the audit log, not just admin changes.
# AUDIT_ALL_REQUESTS=false
# Stream audit events to your SIEM: JSON lines on stdout, and/or a signed webhook.
# AUDIT_LOG_STDOUT=false
# AUDIT_WEBHOOK_URL=
# AUDIT_WEBHOOK_SECRET=
# Days to keep the audit log. 0 = forever.
# AUDIT_RETENTION_DAYS=365
# Zero-data-retention teams: minutes their crawl/extract results are kept.
# ZDR_RETENTION_MINUTES=60
# How long each process caches keys and team settings (ms).
# TENANCY_CACHE_MS=5000

# --- Network (Docker) -----------------------------------------------------------
# Port on your machine.
MINICRAWL_PORT=3002
# 0.0.0.0 = reachable from other devices on your network; 127.0.0.1 = this machine only.
MINICRAWL_BIND=0.0.0.0
# Secret for the bundled SearXNG (any random string).
SEARXNG_SECRET=
# Prebuilt image version to run: latest, a release like 1.1.0, or edge (newest main).
# MINICRAWL_VERSION=latest

# --- Scale mode (docker-compose.scale.yml / Helm) --------------------------------
# Password for the bundled Postgres in docker-compose.scale.yml (any random string).
POSTGRES_PASSWORD=
# Outside the scale compose (npm start, your own setup), point at any Postgres 14+:
# STORAGE=postgres
# DATABASE_URL=postgres://user:password@host:5432/minicrawl
# MODE=all                # all | api (HTTP only) | worker (jobs only)
# PG_POOL_MAX=10
# JOB_LOCK_TIMEOUT_MS=60000   # a crashed worker's jobs are retried after this long

# --- Search (local npm start only; Docker always uses its bundled SearXNG) -----
# SEARXNG_ENDPOINT=http://localhost:8080

# --- AI extraction (json and summary formats, /v1/extract) --------------------------
# Option 1, a local model (nothing leaves your machine): any OpenAI-compatible server.
#   Bundled Ollama (docker compose --profile local-ai up -d):
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen3:8b
#   Or your own: Ollama http://host.docker.internal:11434/v1, LM Studio :1234/v1,
#   vLLM :8000/v1, llama.cpp server :8080/v1. LLM_API_KEY if the server wants one.
# LLM_API_KEY=
# LLM_BATCH_CHARS=40000        # page text per request; lower it for small context windows
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_TIMEOUT_MS=300000
#
# Option 2, Claude (default when LLM_BASE_URL is unset). Key: https://console.anthropic.com
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# LLM_FALLBACKS=true
# EXTRACT_MAX_PAGES=10

# --- Proxies ----------------------------------------------------------------------
# Basic pool, rotated: http://user:pass@host:port,http://host2:port
# PROXY_URLS=
# Stealth pool (e.g. residential proxies), used for proxy:"stealth" and when a site blocks.
# STEALTH_PROXY_URLS=

# --- Performance --------------------------------------------------------------------
# WORKERS=4
# BROWSER_CONCURRENCY=4
# MAX_OCR_PAGES=20
# OCR_DPI=200
# auto = use the GPU if available (falls back to CPU); cpu = never use the GPU
# OCR_PROVIDER=auto
# INTERSTITIAL_WAIT_MS=15000

# --- Page cache (maxAge) ----------------------------------------------------------------
# Fetched pages are kept in the database and reused when a request sends maxAge.
# PAGE_CACHE=true
# PAGE_CACHE_TTL_HOURS=48         # how long entries are kept
# PAGE_CACHE_DEFAULT_MAX_AGE_MS=0 # maxAge for requests without one (0 = only when asked)
# PAGE_CACHE_MAX_BYTES=5000000    # compressed pages larger than this aren't cached

# --- Data retention -------------------------------------------------------------------
# Hours to keep crawl/extract results (the expiresAt in responses). 0 = forever.
# DATA_TTL_HOURS=24
# Days /v1/map remembers URLs it has seen. 0 = forever.
# SEEN_URLS_TTL_DAYS=30

# --- Safety -------------------------------------------------------------------------
# Allow scraping localhost / private network addresses (off by default: SSRF protection).
# ALLOW_PRIVATE_URLS=false
