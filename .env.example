# minicrawl settings. Easiest: run scripts/setup.sh (or scripts\setup.ps1), which
# creates .env with your own generated keys. Or copy this file to `.env` and edit it.
# Never commit .env or share it: it holds YOUR keys (git and Docker already ignore it).
# Used by `docker compose` and by `npm start` (local, without Docker).
# Lines starting with # are ignored. Leave a value empty to use the default.

# --- Access -------------------------------------------------------------------
# Required in Docker. Clients send it as:  Authorization: Bearer <key>
# Generate one:  openssl rand -hex 32
#   (PowerShell:  -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_}))
API_KEY=
# Several keys (one per person/app), comma-separated. Works alongside API_KEY.
# API_KEYS=key-for-alice,key-for-bob
# Run without any key (only on a trusted machine/network).
# ALLOW_NO_AUTH=true

# --- Network (Docker) -----------------------------------------------------------
# Port on your machine.
MINICRAWL_PORT=3002
# 0.0.0.0 = reachable from other devices on your network; 127.0.0.1 = this machine only.
MINICRAWL_BIND=0.0.0.0
# Secret for the bundled SearXNG (any random string).
SEARXNG_SECRET=
# Prebuilt image version to run: latest, a release like 1.1.0, or edge (newest main).
# MINICRAWL_VERSION=latest

# --- Search (local npm start only; Docker always uses its bundled SearXNG) -----
# SEARXNG_ENDPOINT=http://localhost:8080

# --- AI extraction (json format, /v1/extract) -----------------------------------
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# LLM_FALLBACKS=true
# EXTRACT_MAX_PAGES=10

# --- Proxies ----------------------------------------------------------------------
# Basic pool, rotated: http://user:pass@host:port,http://host2:port
# PROXY_URLS=
# Stealth pool (e.g. residential proxies), used for proxy:"stealth" and when a site blocks.
# STEALTH_PROXY_URLS=

# --- Performance --------------------------------------------------------------------
# WORKERS=4
# BROWSER_CONCURRENCY=4
# MAX_OCR_PAGES=20
# OCR_DPI=200
# auto = use the GPU if available (falls back to CPU); cpu = never use the GPU
# OCR_PROVIDER=auto
# INTERSTITIAL_WAIT_MS=15000

# --- Data retention -------------------------------------------------------------------
# Hours to keep crawl/extract results (the expiresAt in responses). 0 = forever.
# DATA_TTL_HOURS=24
# Days /v1/map remembers URLs it has seen. 0 = forever.
# SEEN_URLS_TTL_DAYS=30

# --- Safety -------------------------------------------------------------------------
# Allow scraping localhost / private network addresses (off by default: SSRF protection).
# ALLOW_PRIVATE_URLS=false
